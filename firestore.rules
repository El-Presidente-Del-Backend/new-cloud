      return request.auth != null;
    }
    
    // Función para verificar si el usuario es el propietario del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Permitir acceso a los datos del usuario autenticado
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Permitir acceso a las subcollecciones del usuario
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Permitir crear usuarios temporales para compartir
    match /users/{userId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }
    
