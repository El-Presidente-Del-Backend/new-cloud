rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas temporales para desarrollo - MÁS PERMISIVAS
    // IMPORTANTE: Cambiar a reglas más restrictivas antes de producción
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Las siguientes reglas son más seguras y deberían usarse en producción
    // Descomentar estas reglas y eliminar la regla anterior para producción
    
    /*
