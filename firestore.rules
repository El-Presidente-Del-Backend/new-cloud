      allow read: if isOwner(recipientId);
      allow create, update: if isAuthenticated();
    }
    
    // Permitir escribir en sharedByMe de tu propio usuario
    match /users/{ownerId}/sharedByMe/{shareId} {
      allow read, write: if isOwner(ownerId);
    }
    */
  }
}